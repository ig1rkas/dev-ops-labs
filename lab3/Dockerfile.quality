# syntax=docker/dockerfile:1
FROM python:3.12.16-slim@sha256:962f801b08c870ac2a51b72bf02dae38c9a4162319e5e882ec244e198188d54e
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY lab0/app/src/backend/requirements.lock /deps/requirements.lock
RUN --mount=type=cache,target=/root/.cache/pip pip install -r /deps/requirements.lock ruff==0.17.3 httpx==0.28.1
WORKDIR /src
USER 10001
